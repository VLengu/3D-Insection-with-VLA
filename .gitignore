/data/
/data_height/
/checkpoints/
/checkpoints_height/
*.pt
*.pth
*.ckpt

# Future Stage-2 generated artifacts. Source code lives in stage2/data/;
# generated Pilot/Formal datasets use a separate directory.
stage2/generated_data/
stage2/checkpoints/
stage2/outputs/

# Local secrets and machine-specific configuration
.env
.env.*
!.env.example
secrets/
